# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://serumah:serumah@localhost:5432/serumah?schema=public"

# ── API (apps/api) ────────────────────────────────────────
PORT=3000
JWT_SECRET="change-me-in-production"

# ── MinIO Storage ─────────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="serumah"
MINIO_SECRET_KEY="serumah-secret"
MINIO_BUCKET="serumah"

# ── Mobile (apps/mobile, build-time) ──────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_UPDATE_MANIFEST_URL="https://github.com/spacelix/serumah_mono/releases/latest/download/version.json"

# ── GitHub Actions secrets (set in GitHub, not local) ─────
# EXPO_PUBLIC_API_URL        → https://<api-host>
# EXPO_PUBLIC_UPDATE_MANIFEST_URL
# KEYSTORE_BASE64            → base64 of serumah-upload.jks
# KEYSTORE_PASSWORD
# KEY_ALIAS
# KEY_PASSWORD
