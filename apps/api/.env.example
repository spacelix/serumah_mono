PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serumah

JWT_SECRET=dev-secret-ganti-di-produksi

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=serumah
MINIO_PUBLIC_URL=http://localhost:9000

# Redis (log viewer buffer + referential read-cache, BullMQ flush job)
# Lokal: redis://localhost:6379
# Deploy docker-compose: redis://redis:6379 (nama service `redis`)
REDIS_URL=redis://localhost:6379

# ── FCM Push Notification (opsional — tanpa ini notif tidak terkirim) ──
# Ambil dari Firebase Console → Project settings → Service accounts →
# "Generate new private key" (service-account.json). Isi dari file JSON:
#   project_id    → FCM_PROJECT_ID
#   client_email  → FCM_CLIENT_EMAIL
#   private_key   → FCM_PRIVATE_KEY (jangan ubah \n literal → newline asli)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
