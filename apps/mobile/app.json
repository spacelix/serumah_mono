{
  "expo": {
    "name": "Serumah",
    "slug": "serumah",
    "version": "1.9.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "serumah",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.serumah.serumah",
      "versionCode": 17,
      "backgroundColor": "#EFEAE0",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3F6F61",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3F6F61",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 118
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#EFEAE0"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3D6B5C",
          "defaultChannel": "serumah",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Akses foto untuk memilih foto profil.",
          "cameraPermission": "Akses kamera untuk mengambil foto profil."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.30.5",
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.serumah.serumah"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c033064a-0913-42d1-9218-e8a84297ab93"
      }
    },
    "owner": "xavierxxs"
  }
}